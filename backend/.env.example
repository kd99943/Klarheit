# Copy to .env on the VM and fill in real values. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# Generate a random secret >= 32 chars, e.g. openssl rand -hex 32
APP_JWT_SECRET=change-me-jwt-secret
# Set to the published Qoder Site origin after publication, e.g. https://xxx.qoder.site
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
# Set to the public HTTPS backend origin (Cloudflare Tunnel URL), no trailing slash
APP_BACKEND_BASE_URL=http://localhost:8080